SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional email fallback for local email modes.
SENDER_EMAIL=
SENDER_PASSWORD=
RECIPIENT_EMAIL=

# Broad Google Jobs sourcing.
SERPAPI_KEY=
JOB_SEARCH_DAILY_REQUEST_LIMIT=80
JOB_SEARCH_QUERIES=
JOB_SEARCH_LOCATIONS=

# Optional AI ranking.
AI_RANKING_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_BATCH_SIZE=12
AI_DAILY_JOB_LIMIT=100

# Email status updater (email_sync.py). Reads Gmail, classifies recruiter/ATS
# emails, and updates job statuses. See scripts/gmail_oauth_setup.py to mint the
# refresh token once from an OAuth client's downloaded credentials.json.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional tuning:
GMAIL_SEARCH_QUERY=newer_than:7d -in:chats -from:me
EMAIL_MAX_MESSAGES=60
EMAIL_AUTOAPPLY_CONFIDENCE=0.8
